# ─────────────────────────────────────────────────────────────────────────────
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environments & secrets  (API keys live here — never commit)
.env
.venv/
venv/

# OS
.DS_Store

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# BetterIngest's default out_dir — regenerated by any ingest() call
out/

# ─────────────────────────────────────────────────────────────────────────────
# .ocr_cache/ is intentionally TRACKED. Layout detection costs minutes per page
# on CPU, and committing it is what makes the evaluation replay in minutes with
# no models installed. Do NOT ignore it.
#
# The loose per-call caches it used to sit beside (.pipeline_cache/,
# .gemma_cache/, .llm_cache/, .recon_cache/, .claude_inputs/, .claude_recon/)
# are gone: bench/cache_db.py replaced them with one SQLite file, and the
# scored conditions no longer call an API at all.
# ─────────────────────────────────────────────────────────────────────────────

# Retired corpora: superseded by the frozen manifest, large, and refetchable.
corpus/_pilot/
corpus/_surplus/

# LaTeX build byproducts
*.aux
*.bbl
*.blg
*.out
*.run.xml
*-blx.bib
*.fls
*.fdb_latexmk
*.synctex.gz

# The harness. Both .db files are committed, for different reasons:
#   out1a/ledger.db  the unit table. Tier-0 rows are regenerable in minutes,
#                    but tier-1 rows come from model calls made by hand and
#                    cannot be reproduced — so the ledger is a real artifact.
#   out1a/cache.db   the LLM call cache. Nothing scored reads it any more; it
#                    holds spend from earlier runs that would cost money to
#                    repeat, and it serves the deferred PageIndex seam.
# Their WAL sidecars and the run logs are not committed.
out1a/*.db-wal
out1a/*.db-shm
out1a/*.log
docs/

# Per-document pipeline output (markdown + asset crops), regenerated by a run.
# out1a/llm/ is the exception: those prompts and replies are the record of
# what the model-assisted conditions were asked and answered.
out1a/*/
!out1a/llm/
